# Ghostty configuration
# https://ghostty.org/docs/config/reference

# Keep ordinary shell panes on the zsh-provided directory/branch title. Agent
# TUIs may still publish status titles, which Herdr uses for lifecycle detection.
shell-integration-features = no-title

# Agent hooks emit Ghostty-native OSC 9 desktop notifications.
desktop-notifications = true

# Follow the macOS appearance automatically using themes bundled with Ghostty.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Optional local override: browse `ghostty +list-themes`, press `w`, then reload
# with cmd+shift+comma. The local file can override the adaptive pair without
# dirtying this repository; `?` stays quiet until that file exists.
#
# Absolute, not the `?auto/theme.ghostty` the picker suggests: a relative
# config-file resolves against its own file's directory, and this config is a
# symlink into the repo, so `auto/` would be sought here rather than in
# ~/.config/ghostty where `w` writes.
config-file = ?~/.config/ghostty/auto/theme.ghostty
