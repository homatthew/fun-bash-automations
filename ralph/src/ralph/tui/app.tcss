/* Ralph Wiggum theme */
Screen {
    background: #0f1115;
    color: #e6e6e6;
}

.panel-title {
    text-style: bold;
    color: #9fe8d2;
    padding: 0 0 1 0;
}

/* Shared header */
#header-bar {
    dock: top;
    height: 1;
    background: #1b232d;
    color: #dbe7ff;
    padding: 0 1;
}

/* Studio layout */
#studio-body {
    height: 1fr;
}

#plan-panel {
    width: 28;
    min-width: 20;
    padding: 1;
    background: #131820;
}

#filter-input {
    dock: top;
    margin-bottom: 1;
    background: #0f141b;
}

#filter-input:focus {
    border: tall #9fe8d2;
}

#plan-list {
    height: 1fr;
}

PlanItem {
    padding: 0 1;
}

PlanItem:hover {
    background: #1a2233;
}

#plan-hint {
    dock: bottom;
    color: #6b7a8d;
    padding-top: 1;
}

NewPlanItem {
    border-bottom: dashed #263140;
    padding: 0 1;
}

#preview-panel {
    width: 2fr;
    padding: 1 2;
    background: #10151c;
}

#preview-pane {
    height: 1fr;
    overflow-y: auto;
}

#ops-panel {
    width: 1fr;
    min-width: 24;
    padding: 1 2;
    background: #131820;
}

#ideate-hints {
    color: #b7c1d1;
    margin-bottom: 1;
}

#idea-input {
    margin-bottom: 1;
    background: #0f141b;
}

#ideate-status {
    height: 1;
    color: #9fe8d2;
    margin-bottom: 1;
}

#status-pane {
    height: 8;
    overflow-y: auto;
    margin-bottom: 1;
}

#tail-pane {
    height: 1fr;
    border: tall #263140;
    padding: 0 1;
    background: #0f141b;
}

/* Runner layout */
#runner-body {
    height: 1fr;
}

#runner-log {
    width: 2fr;
    padding: 1 1 1 2;
    background: #0f141b;
}

#output-pane {
    height: 1fr;
}

#runner-side {
    width: 1fr;
    min-width: 24;
    padding: 1 2;
    background: #131820;
}

#stories-content {
    height: 1fr;
    overflow-y: auto;
    margin-bottom: 1;
}

#activity-content {
    height: 12;
    margin-bottom: 1;
}

#controls-content {
    height: 5;
}

DirectiveInput {
    align: center middle;
}

DirectiveInput Input {
    width: 60;
}

ConfirmRun {
    align: center middle;
}

#confirm-dialog {
    width: 60;
    padding: 1 2;
    background: #1b232d;
    border: tall #2e3b4d;
}

.dialog-title {
    text-style: bold;
    color: #9fe8d2;
}

#confirm-detail {
    margin: 1 0;
}

#confirm-buttons {
    align: center middle;
    height: 3;
}

#confirm-buttons Button {
    margin: 0 1;
}
