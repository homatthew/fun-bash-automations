{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/beads-prime.sh",
            "statusMessage": "Priming beads context",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/ctxreview-session-start.sh",
            "statusMessage": "Reconciling review lifecycle",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/bash-safety-guard.sh",
            "statusMessage": "Checking Bash command",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/cursor-mode-guard.sh",
            "statusMessage": "Checking Cursor launch mode",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/permission-allow.sh",
            "statusMessage": "Auto-allow for read-only Bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/post-tool-audit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/ctxreview-session-end.sh",
            "statusMessage": "Reclaiming owned review sessions",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
