{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/beads-prime.sh",
            "statusMessage": "Priming beads context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/bash-safety-guard.sh",
            "statusMessage": "Checking Bash command",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/dgw-write-guard.sh",
            "statusMessage": "Checking DGW KV write policy",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/permission-allow.sh",
            "statusMessage": "Auto-allow for read-only Bash",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/notify.sh",
            "statusMessage": "Marking task active",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/post-tool-audit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__sourcegraph.*|sourcegraph.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/sourcegraph-auth-hint.sh",
            "statusMessage": "Checking Sourcegraph auth failure",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/notify.sh",
            "statusMessage": "Sending notification",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
