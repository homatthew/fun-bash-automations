{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homatthew/fun-bash-automations/llm/agent-push-policy.schema.json",
  "title": "Agent Push Policy",
  "type": "object",
  "required": ["version", "scratch_branches", "yolo_branches", "delivery_branches", "direct_push_exceptions"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "model": { "type": "string" },
    "no_mistakes_branches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string" },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gate": { "type": "string", "const": "no-mistakes" },
        "pr_eligible": { "type": "boolean", "const": true },
        "requires_explicit_user_ask": { "type": "boolean" },
        "protected_base_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "gnhf_branches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string" },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gate": { "type": "string", "const": "no-mistakes" },
        "pr_eligible": { "type": "boolean", "const": true },
        "protected_base_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "scratch_branches": {
      "type": "object",
      "required": [
        "enabled",
        "default_for_agents",
        "commit_push_cadence",
        "prefixes",
        "remotes",
        "requires_user_opt_in",
        "must_not_have_open_pr",
        "must_not_be_pr_base",
        "allow_delete"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "default_for_agents": { "type": "boolean", "const": false },
        "purpose": { "type": "string" },
        "commit_push_cadence": {
          "type": "object",
          "required": ["mode", "events"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "const": "regular_milestones" },
            "events": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "after_coherent_checkpoint",
                  "after_verification_pass",
                  "before_long_running_or_interruptible_work",
                  "before_handoff_or_context_compaction"
                ]
              },
              "allOf": [
                { "contains": { "const": "after_coherent_checkpoint" } },
                { "contains": { "const": "after_verification_pass" } },
                { "contains": { "const": "before_long_running_or_interruptible_work" } },
                { "contains": { "const": "before_handoff_or_context_compaction" } }
              ]
            }
          }
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "remotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requires_user_opt_in": { "type": "boolean", "const": true },
        "must_not_have_open_pr": { "type": "boolean", "const": true },
        "must_not_be_pr_base": { "type": "boolean", "const": true },
        "allow_delete": { "type": "boolean", "const": false }
      }
    },
    "yolo_branches": {
      "type": "object",
      "required": [
        "enabled",
        "prefixes",
        "remotes",
        "requires_user_opt_in",
        "pr_eligible",
        "allow_delete",
        "requires_explicit_user_ask",
        "protected_base_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "purpose": { "type": "string" },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "remotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requires_user_opt_in": { "type": "boolean", "const": false },
        "pr_eligible": { "type": "boolean", "const": true },
        "allow_delete": { "type": "boolean", "const": true },
        "requires_explicit_user_ask": { "type": "boolean", "default": true },
        "protected_base_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "delivery_branches": {
      "type": "object",
      "required": ["pr_eligible"],
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string", "const": "no-mistakes" },
        "pr_eligible": { "type": "boolean", "const": true },
        "notes": { "type": "string" }
      }
    },
    "direct_push_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "delivery_branch",
          "requires_explicit_user_ask",
          "disallow_pr_to_main"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "delivery_branch": { "type": "string", "minLength": 1 },
          "requires_explicit_user_ask": { "type": "boolean", "const": true },
          "disallow_pr_to_main": { "type": "boolean", "const": true }
        }
      }
    }
  }
}
