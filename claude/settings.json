{
  "alwaysThinkingEnabled": true,
  "apiKeyHelper": "echo sk-1234",
  "autoUpdatesChannel": "latest",
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "caveman@caveman": true,
    "codex@openai-codex": true,
    "code-review@claude-plugins-official": true,
    "elements-of-style@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "interface-design@interface-design": true,
    "ods-datastores-minimal@ods-datastores-minimal": true,
    "ods-first-team@ods-first-team-skills": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "ods-datastores-minimal": {
      "source": {
        "source": "git",
        "url": "https://git.netflix.net/matthewho/cde-ods-skills.git"
      }
    }
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://claudecode.local.dev.netflix.net:9123/",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://claudemetricscollector.cluster.us-east-1.prod.cloud.netflix.net:4318",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_RESOURCE_ATTRIBUTES": "user.netflix_email=__USER_NETFLIX_EMAIL__,runtime_environment=local,wrapper.version=2603081044"
  },
  "fastMode": false,
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command",
            "timeout": 15
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command",
            "timeout": 15
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/beads-prime.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/bash-safety-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/dgw-write-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/sourcegraph-auth-hint.sh",
            "type": "command",
            "timeout": 5
          }
        ],
        "matcher": "mcp__sourcegraph.*|sourcegraph.*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/sourcegraph-auth-hint.sh",
            "type": "command",
            "timeout": 5
          }
        ],
        "matcher": "mcp__sourcegraph.*|sourcegraph.*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/beads-prime.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command",
            "timeout": 15
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "claude-opus-4-7[1m]",
  "permissions": {
    "allow": [],
    "defaultMode": "plan"
  },
  "showClearContextOnPlanAccept": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  }
}
