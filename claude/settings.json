{
  "alwaysThinkingEnabled": true,
  "apiKeyHelper": "echo sk-1234",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:9123/mtlsproxy:claudecode",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://claudemetricscollector.cluster.us-east-1.prod.cloud.netflix.net:4318",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_RESOURCE_ATTRIBUTES": "user.netflix_email=matthewho@netflix.com,runtime_environment=local"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify-done.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus"
}
