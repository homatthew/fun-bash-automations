#!/usr/bin/env node

const fs = require('fs');

function stripComments(input) {
  let output = '';
  let state = 'normal';
  let escaped = false;
  for (let index = 0; index < input.length; index += 1) {
    const char = input[index];
    const next = input[index + 1];
    if (state === 'string') {
      output += char;
      if (escaped) escaped = false;
      else if (char === '\\') escaped = true;
      else if (char === '"') state = 'normal';
      continue;
    }
    if (state === 'line') {
      if (char === '\n' || char === '\r') {
        output += char;
        state = 'normal';
      } else {
        output += ' ';
      }
      continue;
    }
    if (state === 'block') {
      if (char === '*' && next === '/') {
        output += '  ';
        index += 1;
        state = 'normal';
      } else {
        output += char === '\n' || char === '\r' ? char : ' ';
      }
      continue;
    }
    if (char === '"') {
      output += char;
      state = 'string';
    } else if (char === '/' && next === '/') {
      output += '  ';
      index += 1;
      state = 'line';
    } else if (char === '/' && next === '*') {
      output += '  ';
      index += 1;
      state = 'block';
    } else {
      output += char;
    }
  }
  if (state === 'block') throw new Error('unterminated block comment');
  return output;
}

function stripTrailingCommas(input) {
  let output = '';
  let inString = false;
  let escaped = false;
  for (let index = 0; index < input.length; index += 1) {
    const char = input[index];
    if (inString) {
      output += char;
      if (escaped) escaped = false;
      else if (char === '\\') escaped = true;
      else if (char === '"') inString = false;
      continue;
    }
    if (char === '"') {
      inString = true;
      output += char;
      continue;
    }
    if (char === ',') {
      let lookahead = index + 1;
      while (/\s/.test(input[lookahead] || '')) lookahead += 1;
      if (input[lookahead] === '}' || input[lookahead] === ']') continue;
    }
    output += char;
  }
  return output;
}

const path = process.argv[2];
if (!path) throw new Error('settings path is required');
const raw = fs.readFileSync(path, 'utf8');
const settings = JSON.parse(stripTrailingCommas(stripComments(raw)));
settings['terminalNotification.preferOsNotifications'] = false;
settings['terminalNotification.showVsCodeNotification'] = false;
fs.writeFileSync(path, `${JSON.stringify(settings, null, 4)}\n`);
