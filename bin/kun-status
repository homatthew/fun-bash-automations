#!/usr/bin/env bash
# kun-status — one-glance state of the Kun stack as token-efficient TOON (AXI).
#
# Surfaces four substrates of the Kun agent stack for the current repository:
#   pool   treehouse worktree pool          (source: `treehouse status`)
#   gate   no-mistakes validation gate       (source: `no-mistakes axi status`)
#   crew   firstmate crewmates               (source: tmux windows named `fm-*`)
#   wake   scheduled / cron wakeups          (source: crontab + launchd, best-effort)
#   review ctxreview multi-model review legs  (source: Herdr named sessions)
#
# Output:
#   stdout  structured TOON only (what the agent consumes)
#   stderr  banners, progress, diagnostics (agents ignore this)
#
# Usage:
#   kun-status                 show all sections (default)
#   kun-status --pool          worktree pool only
#   kun-status --gate          no-mistakes gate only
#   kun-status --crew          firstmate crew only
#   kun-status --wake          wake-queue only
#   kun-status --review        ctxreview review legs only
#   kun-status --pool --gate   any combination of section flags
#   kun-status -h | --help     this help
#
# Each source degrades gracefully: a missing tool, absent server, or
# uninitialized repo yields an `unavailable` row, never a crash.
#
# Exit codes: 0 success (including all-unavailable), 2 usage error.

set -euo pipefail

# --- identity -------------------------------------------------------------
self_path() {
    local p="${BASH_SOURCE[0]}"
    # Resolve symlinks where possible without requiring GNU readlink.
    if command -v realpath >/dev/null 2>&1; then
        p="$(realpath "$p" 2>/dev/null || echo "$p")"
    fi
    printf '%s' "${p/#$HOME/~}"
}

DESC="One-glance Kun stack state (pool, gate, crew, wake, review) as TOON."

print_help() {
    # Help reads from this file's own header comment block.
    sed -n '2,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# --- toon emit helpers ----------------------------------------------------
toon_val() {
    local v="$1"
    local quote=false
    case "$v" in
        ""|true|false|null|-*|*,*|*:*|*'"'*|*\\*|*'['*|*']'*|*'{'*|*'}'*) quote=true ;;
    esac
    if [[ "$v" =~ ^[[:space:]] || "$v" =~ [[:space:]]$ || "$v" =~ [[:cntrl:]] ||
          "$v" =~ ^-?[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$ ]]; then
        quote=true
    fi
    if [[ "$quote" == false ]]; then
        printf '%s' "$v"
        return
    fi

    local LC_ALL=C char code i
    printf '"'
    for ((i = 0; i < ${#v}; i++)); do
        char="${v:i:1}"
        case "$char" in
            \\) printf '\\\\' ;;
            '"') printf '\\"' ;;
            $'\n') printf '\\n' ;;
            $'\r') printf '\\r' ;;
            $'\t') printf '\\t' ;;
            *)
                printf -v code '%d' "'$char"
                # Guard the LOW end too. `"'$char"` yields the first byte, which
                # bash reports as NEGATIVE for anything >= 0x80, so `code < 32`
                # was true for every non-ASCII byte and emitted
                # `￿ffffffffffc2` instead of the character. The `·` in a
                # derived review label rendered as exactly that in TOON output.
                # Found by an opus review leg against this file, at this line.
                #
                # Non-ASCII passes through unescaped: TOON here is UTF-8, and only
                # genuine C0 control characters need escaping.
                if ((code >= 0 && code < 32)); then
                    printf '\\u%04x' "$code"
                else
                    printf '%s' "$char"
                fi
                ;;
        esac
    done
    printf '"'
}

toon_field() {
    printf '%s%s: %s\n' "$1" "$2" "$(toon_val "$3")"
}

# --- progress (stderr only) ----------------------------------------------
log() { printf '%s\n' "$*" >&2; }

# =========================================================================
# pool — treehouse worktree pool
# =========================================================================
# treehouse writes ALL of its output (incl. its update banner and the
# "No worktrees in pool." message) to stderr and nothing to stdout, so we
# capture merged output and strip the known banner lines before parsing.
section_pool() {
    log "kun-status: probing treehouse pool..."
    if ! command -v treehouse >/dev/null 2>&1; then
        printf 'pool:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason 'treehouse not installed'
        toon_field '  ' help 'install treehouse to enable the worktree pool'
        return
    fi

    local raw rc=0
    raw="$(treehouse status 2>&1)" || rc=$?
    # Drop the self-update banner and blank lines.
    local body
    body="$(printf '%s\n' "$raw" \
        | grep -vE '^A new version of treehouse is available' \
        | grep -vE '^Run "treehouse update" to update' \
        | sed '/^[[:space:]]*$/d')"

    # Empty pool is a definitive state, even when older treehouse versions
    # report it with a nonzero exit code.
    if printf '%s' "$body" | grep -qiE 'No worktrees in pool'; then
        printf 'pool:\n'
        toon_field '  ' status empty
        printf '  count: 0\n'
        toon_field '  ' help 'Run `treehouse get` to acquire a worktree'
        return
    fi

    if [[ $rc -ne 0 ]]; then
        [[ -z "$body" ]] || log "kun-status: treehouse status output: $body"
        printf 'pool:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason "treehouse status failed (exit $rc)"
        return
    fi

    # Populated pool: each non-header line is a worktree entry. treehouse's
    # human format varies across versions, so we keep a tolerant projection:
    # one `worktrees[N]{line}` array of the raw (banner-stripped) lines.
    local -a lines=()
    while IFS= read -r ln; do
        [[ -n "$ln" ]] && lines+=("$ln")
    done <<< "$body"

    local n="${#lines[@]}"
    if [[ $n -eq 0 ]]; then
        printf 'pool:\n'
        toon_field '  ' status empty
        printf '  count: 0\n'
        return
    fi

    printf 'pool:\n'
    toon_field '  ' status active
    printf '  count: %s\n' "$n"
    printf 'pool_worktrees[%s]{entry}:\n' "$n"
    local ln
    for ln in "${lines[@]}"; do
        printf '  %s\n' "$(toon_val "$ln")"
    done
}

# =========================================================================
# gate — no-mistakes validation gate
# =========================================================================
# `no-mistakes axi status` is itself AXI: structured output on stdout,
# banner on stderr. We surface it directly, normalizing the common states
# (no repo, not initialized, no runs, active/recent run) into a stable schema.
section_gate() {
    log "kun-status: probing no-mistakes gate..."
    if ! command -v no-mistakes >/dev/null 2>&1; then
        printf 'gate:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason 'no-mistakes not installed'
        toon_field '  ' help 'install no-mistakes to enable the validation gate'
        return
    fi

    local out err status_text err_file rc=0
    err_file="$(mktemp "${TMPDIR:-/tmp}/kun-status-gate.XXXXXX")"
    out="$(no-mistakes axi status 2>"$err_file")" || rc=$?
    err="$(cat "$err_file")"
    rm -f "$err_file"
    status_text="$out"
    if [[ -n "$err" ]]; then
        status_text="${status_text}${status_text:+$'\n'}${err}"
    fi

    if [[ -z "$status_text" ]]; then
        printf 'gate:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason "no-mistakes returned no output (exit $rc)"
        return
    fi

    # not initialized for this repo → a clear, actionable state (not a crash).
    if printf '%s' "$status_text" | grep -qiE 'not initialized'; then
        printf 'gate:\n'
        toon_field '  ' status not-initialized
        toon_field '  ' reason 'no-mistakes gate not set up in this repository'
        toon_field '  ' help 'Run `no-mistakes init` to enable the gate here'
        return
    fi
    if printf '%s' "$status_text" | grep -qiE 'not (in|inside) a git repository'; then
        printf 'gate:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason 'not inside a git repository'
        return
    fi
    if printf '%s' "$status_text" | grep -qiE 'no runs'; then
        printf 'gate:\n'
        toon_field '  ' status idle
        printf '  runs: 0\n'
        toon_field '  ' help 'Run `no-mistakes axi run` to validate changes'
        return
    fi
    if [[ $rc -ne 0 ]]; then
        [[ -z "$out" ]] || log "kun-status: no-mistakes status output: $out"
        [[ -z "$err" ]] || log "kun-status: no-mistakes status error: $err"
        printf 'gate:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason "no-mistakes status failed (exit $rc)"
        return
    fi

    # Active or recent run: no-mistakes already emits AXI TOON. Re-key it
    # under our `gate` namespace and pass its structured lines through.
    printf 'gate:\n'
    toon_field '  ' status reported
    printf '%s\n' "$out" | sed 's/^/  /'
}

# =========================================================================
# crew — firstmate crewmates (tmux windows named fm-*)
# =========================================================================
section_crew() {
    log "kun-status: probing firstmate crew (tmux fm-*)..."
    if ! command -v tmux >/dev/null 2>&1; then
        printf 'crew:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason 'tmux not installed'
        toon_field '  ' help 'firstmate crewmates run in tmux windows named fm-*'
        return
    fi

    local raw rc=0
    # If no server is running tmux prints "no server running..." to stderr
    # and exits non-zero; treat that as a definitive "no crew".
    raw="$(tmux list-windows -a -F '#{window_name}	#{session_name}:#{window_index}	#{window_active}	#{pane_current_command}' 2>/dev/null)" || rc=$?

    if [[ $rc -ne 0 ]]; then
        printf 'crew:\n'
        toon_field '  ' status offline
        printf '  count: 0\n'
        toon_field '  ' reason 'no tmux server running'
        return
    fi

    # Select only firstmate crewmate windows.
    local fm
    fm="$(printf '%s\n' "$raw" | awk -F'\t' '$1 ~ /^fm-/')"

    if [[ -z "$fm" ]]; then
        printf 'crew:\n'
        toon_field '  ' status idle
        printf '  count: 0\n'
        toon_field '  ' help 'crewmates appear as tmux windows named fm-*; launch via firstmate'
        return
    fi

    local n
    n="$(printf '%s\n' "$fm" | grep -c . )"
    printf 'crew:\n'
    toon_field '  ' status active
    printf '  count: %s\n' "$n"
    printf 'crew_members[%s]{name,window,active,cmd}:\n' "$n"
    local name win act cmd
    while IFS=$'\t' read -r name win act cmd; do
        [[ -z "$name" ]] && continue
        printf '  %s,%s,%s,%s\n' \
            "$(toon_val "$name")" "$(toon_val "$win")" \
            "$(toon_val "$act")" "$(toon_val "$cmd")"
    done <<< "$fm"
}

# =========================================================================
# wake — scheduled / cron wakeups (best-effort)
# =========================================================================
# There is no dedicated wake-queue daemon in this stack today, so we probe
# the generic schedulers (user crontab + per-user launchd agents) for any
# Kun/firstmate/wake-tagged jobs. When no source yields anything we say so
# explicitly rather than implying a queue exists.
section_wake() {
    log "kun-status: probing wake-queue (cron/launchd)..."
    local -a entries=()
    local probed=0

    # 1) user crontab
    if command -v crontab >/dev/null 2>&1; then
        probed=1
        local cron
        cron="$(crontab -l 2>/dev/null | grep -vE '^[[:space:]]*#' | sed '/^[[:space:]]*$/d' \
            | grep -iE 'wake|wakeup|firstmate|fm-|crewmate' || true)"
        if [[ -n "$cron" ]]; then
            while IFS= read -r ln; do
                [[ -n "$ln" ]] && entries+=("cron	$ln")
            done <<< "$cron"
        fi
    fi

    # 2) per-user launchd agents (macOS)
    if command -v launchctl >/dev/null 2>&1; then
        probed=1
        local la
        la="$(launchctl list 2>/dev/null \
            | awk 'NR>1 {print $3}' \
            | grep -iE 'wake|wakeup|firstmate|crewmate' || true)"
        if [[ -n "$la" ]]; then
            while IFS= read -r ln; do
                [[ -n "$ln" ]] && entries+=("launchd	$ln")
            done <<< "$la"
        fi
    fi

    if [[ $probed -eq 0 ]]; then
        printf 'wake:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason 'no scheduler available (crontab/launchctl not found)'
        return
    fi

    local n="${#entries[@]}"
    if [[ $n -eq 0 ]]; then
        printf 'wake:\n'
        toon_field '  ' status empty
        printf '  count: 0\n'
        toon_field '  ' reason 'no dedicated wake-queue source; no matching cron/launchd jobs'
        return
    fi

    printf 'wake:\n'
    toon_field '  ' status scheduled
    printf '  count: %s\n' "$n"
    printf 'wake_jobs[%s]{source,job}:\n' "$n"
    local src job e
    for e in "${entries[@]}"; do
        src="${e%%	*}"; job="${e#*	}"
        printf '  %s,%s\n' "$(toon_val "$src")" "$(toon_val "$job")"
    done
}

# =========================================================================
# review — ctxreview multi-model review legs (source: Herdr named sessions)
# =========================================================================
# Review legs stay conversible while their parent is active. The lifecycle
# manager reclaims them after owner end or settled retention; this section shows
# live legs plus persisted lifecycle health so missed cleanup remains visible.
section_review() {
    log "kun-status: probing ctxreview named sessions..."
    if ! command -v herdr >/dev/null 2>&1; then
        printf 'review:\n'
        toon_field '  ' status unavailable
        toon_field '  ' reason 'herdr not installed'
        return
    fi

    local state_dir="${CTXREVIEW_SESSION_STATE_DIR:-$HOME/.local/state/ctxreview/sessions}"
    local records=("$state_dir"/runs/*.json) sessions rows record
    local tracked=0 running=0 stopped=0 working=0 settled=0
    rows="$(mktemp "${TMPDIR:-/tmp}/kun-status-review.XXXXXX")" || return
    : > "$rows"
    sessions="$(herdr session list --json 2>/dev/null || printf '{"sessions":[]}')"

    for record in "${records[@]}"; do
        [[ -s "$record" ]] || continue
        local name run label state leg_summary agents
        name="$(jq -r '.herdr_session_name // empty' "$record" 2>/dev/null)"
        [[ -n "$name" ]] || continue
        run="$(jq -r '.run_id // "?"' "$record")"
        label="$(jq -r '.label // "?"' "$record")"
        tracked=$((tracked+1))
        if printf '%s' "$sessions" | jq -e --arg name "$name" \
            '.sessions[]? | select(.name==$name and .running==true)' >/dev/null 2>&1; then
            state=running
            running=$((running+1))
            agents="$(herdr --session "$name" agent list 2>/dev/null || printf '{"result":{"agents":[]}}')"
            leg_summary="$(printf '%s' "$agents" | jq -r '
              [.result.agents[]? | select(.name // "" | startswith("ctxreview-")) |
               ((.name | sub("^ctxreview-";"") | sub("-w[0-9].*$";"")) +
                "(" + (.agent_status // "?") + ")")] | join(" ")' 2>/dev/null)"
            working=$((working + $(printf '%s' "$agents" | jq -r \
              '[.result.agents[]? | select(.agent_status=="working")]|length' 2>/dev/null || printf 0)))
            settled=$((settled + $(printf '%s' "$agents" | jq -r \
              '[.result.agents[]? | select(.agent_status=="idle" or .agent_status=="done")]|length' 2>/dev/null || printf 0)))
            printf '%s\t%s\t%s\t%s\t%s\n' "$run" "$name" "$state" "$label" "$leg_summary" >> "$rows"
        else
            state=stopped
            stopped=$((stopped+1))
        fi
    done

    printf 'review:\n'
    if [[ "$tracked" -eq 0 ]]; then
        toon_field '  ' status idle
        printf '  count: 0\n'
        toon_field '  ' help 'ctxreview fans a context pack out in an isolated Herdr session'
        rm -f "$rows"
        return
    fi
    if [[ "$working" -gt 0 ]]; then
        toon_field '  ' status working
    elif [[ "$running" -gt 0 ]]; then
        toon_field '  ' status settled
    else
        toon_field '  ' status idle
    fi
    printf '  count: %s\n' "$running"
    printf '  running_sessions: %s\n' "$running"
    printf '  persisted_stopped_sessions: %s\n' "$stopped"
    printf '  working: %s\n' "$working"
    printf '  settled: %s\n' "$settled"
    printf '  sessions[%s]{run,session,state,label,legs}:\n' "$running"
    while IFS=$'\t' read -r run name state label leg_summary; do
        printf '    %s,%s,%s,%s,%s\n' \
          "$(toon_val "$run")" "$(toon_val "$name")" "$(toon_val "$state")" \
          "$(toon_val "$label")" "$(toon_val "${leg_summary:-none}")"
    done < "$rows"
    rm -f "$rows"

    printf '  focus_isolation:\n'
    toon_field '    ' strategy named_herdr_session_socket
    printf '    default_session_mutations: 0\n'
    local focus_file="$state_dir/focus-events.jsonl"
    if [[ -s "$focus_file" ]]; then
        printf '    historical_focus_drifts: %s\n' \
          "$(jq -s 'map(select(.focus_drift==true))|length' "$focus_file" 2>/dev/null || printf 0)"
        printf '    historical_restore_failed: %s\n' \
          "$(jq -s 'map(select(.restore_outcome=="failed"))|length' "$focus_file" 2>/dev/null || printf 0)"
    fi
    toon_field '  ' stats 'ctxreview --stats'
    [[ "$settled" -eq 0 ]] || toon_field '  ' maintain 'ctxreview --maintain --all'

    local bugs_file="${CTXREVIEW_BUGS_FILE:-$HOME/.local/state/ctxreview/bugs.jsonl}"
    if [[ -s "$bugs_file" ]]; then
        local open_bugs
        open_bugs="$(jq -r 'select(.status=="open")|1' "$bugs_file" 2>/dev/null | grep -c . || true)"
        [[ "${open_bugs:-0}" -eq 0 ]] || {
            printf '  tool_bugs_open: %s\n' "$open_bugs"
            toon_field '  ' tool_bugs 'ctxreview --bugs'
        }
    fi
}

# --- arg parsing ----------------------------------------------------------
want_pool=0 want_gate=0 want_crew=0 want_wake=0 want_review=0 any=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pool) want_pool=1; any=1 ;;
        --gate) want_gate=1; any=1 ;;
        --crew) want_crew=1; any=1 ;;
        --wake) want_wake=1; any=1 ;;
        --review) want_review=1; any=1 ;;
        -h|--help) print_help; exit 0 ;;
        --) shift; break ;;
        -*)
            output="$(toon_field '' error "unknown flag: $1"; toon_field '' help 'kun-status [--pool] [--gate] [--crew] [--wake] [--review] | --help')"
            printf '%s' "$output"
            exit 2 ;;
        *)
            output="$(toon_field '' error "unexpected argument: $1"; toon_field '' help 'kun-status [--pool] [--gate] [--crew] [--wake] [--review] | --help')"
            printf '%s' "$output"
            exit 2 ;;
    esac
    shift
done

if [[ $# -gt 0 ]]; then
    output="$(toon_field '' error "unexpected argument: $1"; toon_field '' help 'kun-status [--pool] [--gate] [--crew] [--wake] [--review] | --help')"
    printf '%s' "$output"
    exit 2
fi

# Default = all sections.
if [[ $any -eq 0 ]]; then
    want_pool=1 want_gate=1 want_crew=1 want_wake=1 want_review=1
fi

# --- home view header (identity, per AXI §10) -----------------------------
output="$({
    toon_field '' bin "$(self_path)"
    toon_field '' description "$DESC"
    [[ $want_pool -eq 1 ]] && section_pool
    [[ $want_gate -eq 1 ]] && section_gate
    [[ $want_crew -eq 1 ]] && section_crew
    [[ $want_wake -eq 1 ]] && section_wake
    [[ $want_review -eq 1 ]] && section_review
    true
})"
printf '%s' "$output"

exit 0
