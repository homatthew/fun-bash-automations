#!/usr/bin/env bash
# Build and install the forked vscode-terminal-osc-notifier extension.
#
# Why this exists:
#   llm/hooks/notify.sh and notify-slack.sh emit an OSC 777 carrying a
#   caller-supplied `tid`. The forked extension binds that tid to the
#   emitting VS Code terminal and exposes a URI handler that focuses the
#   bound terminal on click. Upstream doesn't support the tid shape, so
#   we ship a local build.
#
# Idempotent: re-running pulls, rebuilds, re-packages, and re-installs.
# Preserves all other keys in the VS Code User settings.json via jq.

set -euo pipefail

EXT_REPO="$HOME/repos/vscode-terminal-osc-notifier"
EXT_PUBLISHER="homatthew"
EXT_NAME="vscode-terminal-osc-notifier"
EXT_VERSION="0.1.5"
UPSTREAM_PUBLISHER="wenbopan"
VSIX_OUT="/tmp/osc-notifier.vsix"
VSCODE_SETTINGS="$HOME/Library/Application Support/Code/User/settings.json"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "install-osc-notifier: macOS only; skipping" >&2
  exit 0
fi

require_cmd() {
  local cmd="$1" hint="$2"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "install-osc-notifier: $cmd not on PATH — $hint" >&2
    exit 1
  fi
}

require_cmd git  "install Xcode Command Line Tools or brew install git"
require_cmd node "brew install node"
require_cmd npm  "brew install node"
require_cmd jq   "brew install jq"
require_cmd code "open VS Code → Cmd-Shift-P → \"Shell Command: Install 'code' command in PATH\""

if [[ ! -d "$EXT_REPO" ]]; then
  echo "install-osc-notifier: cloning $EXT_PUBLISHER/$EXT_NAME into $EXT_REPO" >&2
  git clone "git@github.com:${EXT_PUBLISHER}/${EXT_NAME}.git" "$EXT_REPO"
else
  git -C "$EXT_REPO" pull --ff-only --quiet 2>/dev/null || true
fi

if ! grep -q 'userTid' "$EXT_REPO/src/extension.ts"; then
  echo "install-osc-notifier: $EXT_REPO/src/extension.ts is missing the tid-binding patch." >&2
  echo "  Either you're on upstream or the patch was reverted. Skipping build." >&2
  exit 0
fi

cd "$EXT_REPO"

if [[ ! -d node_modules ]] || [[ package.json -nt node_modules ]]; then
  echo "install-osc-notifier: npm install" >&2
  npm install --silent
fi

echo "install-osc-notifier: building" >&2
npm run build --silent

echo "install-osc-notifier: packaging" >&2
rm -f "$VSIX_OUT"
npx --yes @vscode/vsce package --out "$VSIX_OUT" >/dev/null

# Best-effort removal of the upstream copy so both don't race.
code --uninstall-extension "${UPSTREAM_PUBLISHER}.${EXT_NAME}" >/dev/null 2>&1 || true

code --install-extension "$VSIX_OUT" --force >/dev/null

# Silence the extension's own OS banner + in-editor toast. We drive
# the banner via alerter ourselves; leaving these enabled gives a
# double notification. VS Code settings is jsonc (trailing commas +
# line comments), which jq can't parse, so we use node — already a
# prerequisite for the extension build.
mkdir -p "$(dirname "$VSCODE_SETTINGS")"
if [[ ! -f "$VSCODE_SETTINGS" ]]; then
  printf '{}\n' > "$VSCODE_SETTINGS"
fi
node - "$VSCODE_SETTINGS" <<'NODE'
const fs = require('fs');
const path = process.argv[2];
const raw = fs.readFileSync(path, 'utf8');
// Strip // line comments, /* ... */ block comments, and trailing
// commas before JSON.parse. Good enough for VS Code user settings.
const stripped = raw
  .replace(/\/\*[\s\S]*?\*\//g, '')
  .replace(/(^|[^:])\/\/[^\n]*/g, '$1')
  .replace(/,(\s*[}\]])/g, '$1');
const obj = JSON.parse(stripped);
obj['terminalNotification.preferOsNotifications']   = false;
obj['terminalNotification.showVsCodeNotification'] = false;
fs.writeFileSync(path, JSON.stringify(obj, null, 4) + '\n');
NODE

echo "osc-notifier: installed ${EXT_PUBLISHER}.${EXT_NAME}@${EXT_VERSION}"
