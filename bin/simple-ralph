#!/usr/bin/env bash
# simple-ralph — minimal autonomous Claude loop
#
# Zero deps beyond bash + claude CLI. Best practices from full Ralph
# distilled into a single script. Use this to bootstrap the real Ralph.
#
# Usage:
#   simple-ralph plan.md                      # Execute plan in cwd
#   simple-ralph -n 5 plan.md                # Max 5 iterations
#   simple-ralph -w my-feature plan.md       # Run in a fresh worktree
#   simple-ralph -d ~/worktrees/foo plan.md  # Run in existing directory
#
# Monitor (from another terminal):
#   rt                        # Shell function (tail -f .ralph/output.log)
#   ralph-watch               # Rich console version
#   tail -f .ralph/output.log # Raw (zero deps)

set -euo pipefail

# --- Defaults ---
MAX_ITER=20
PLAN=""
WORK_DIR=""
WORKTREE_NAME=""
RICH=0
TOOLS="Edit Read Write Glob Grep Bash"
WORKTREE_BASE="${HOME}/worktrees"

# --- Parse args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--max)       MAX_ITER="$2"; shift 2 ;;
    -t|--tools)     TOOLS="$2"; shift 2 ;;
    -d|--dir)       WORK_DIR="$2"; shift 2 ;;
    -w|--worktree)  WORKTREE_NAME="$2"; shift 2 ;;
    --rich)        RICH=1; shift ;;
    -h|--help)
      cat <<'HELP'
Usage: simple-ralph [options] plan.md

Options:
  -n, --max N          Max iterations (default: 20)
  -t, --tools T        Tool scope (default: Edit Read Write Glob Grep Bash)
  -d, --dir DIR        Run in this directory
  -w, --worktree NAME  Create worktree and run there
                       Creates: ~/worktrees/ralph-NAME (branch: ralph/NAME)
  --rich              Rich output via ralph-watch (requires Python + Rich)

Monitor from another terminal:
  rt                        # Shell function (tail -f)
  ralph-watch               # Rich console version
  tail -f .ralph/output.log # Raw

Examples:
  simple-ralph plan.md                    # Run in cwd
  simple-ralph -w refactor plan.md        # Run in ~/worktrees/ralph-refactor
  simple-ralph -n 20 -d /some/repo plan.md
HELP
      exit 0 ;;
    -*) echo "Unknown flag: $1"; exit 1 ;;
    *)  PLAN="$1"; shift ;;
  esac
done

[[ -z "$PLAN" ]] && { echo "Usage: simple-ralph [-n N] [-w name] plan.md"; exit 1; }

# Resolve plan to absolute path before any cd
PLAN="$(cd "$(dirname "$PLAN")" && pwd)/$(basename "$PLAN")"
[[ ! -f "$PLAN" ]] && { echo "Plan not found: $PLAN"; exit 1; }

# --- Worktree setup ---
if [[ -n "$WORKTREE_NAME" ]]; then
  BRANCH="ralph/$WORKTREE_NAME"
  WT_DIR="$WORKTREE_BASE/ralph-$WORKTREE_NAME"

  if [[ -d "$WT_DIR" ]]; then
    echo "Worktree already exists: $WT_DIR"
    echo "Resuming in existing worktree."
  else
    echo "Creating worktree: $WT_DIR (branch: $BRANCH)"
    git worktree add -b "$BRANCH" "$WT_DIR" HEAD
  fi
  cd "$WT_DIR"
elif [[ -n "$WORK_DIR" ]]; then
  mkdir -p "$WORK_DIR"
  cd "$WORK_DIR"
fi

# Load .ralphrc if present (safe: only RALPH_* vars)
if [[ -f ".ralphrc" ]]; then
  while IFS='=' read -r key val; do
    key="${key## }"; key="${key%% }"
    val="${val## }"; val="${val%% }"; val="${val#\"}"; val="${val%\"}"
    case "$key" in
      RALPH_TOOLS)    TOOLS="$val" ;;
      RALPH_MAX_ITER) MAX_ITER="$val" ;;
      \#*|"")         ;; # skip comments and blanks
      *)              echo "Warning: ignoring unknown .ralphrc key: $key" ;;
    esac
  done < .ralphrc
fi

# --- Setup ---
RALPH_DIR=".ralph"
mkdir -p "$RALPH_DIR"

# Hide .ralph from git
EXCLUDE=".git/info/exclude"
[[ -f "$EXCLUDE" ]] && ! grep -qx ".ralph" "$EXCLUDE" 2>/dev/null && echo ".ralph" >> "$EXCLUDE"

# Combined output log — this is what you tail
OUTPUT_LOG="$RALPH_DIR/output.log"
: > "$OUTPUT_LOG"  # truncate on fresh start

# --- Meta tracking ---
write_meta() {
  cat > "$RALPH_DIR/meta.json" <<-JSON
	{
	  "plan": "$PLAN",
	  "pid": $$,
	  "status": "$1",
	  "iter": $2,
	  "max_iter": $MAX_ITER,
	  "started": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
	  "cwd": "$(pwd)"
	}
	JSON
}

# --- Prompt builder ---
build_prompt() {
  local progress="Fresh start — no prior iterations."
  [[ -f "$RALPH_DIR/status.md" ]] && progress=$(cat "$RALPH_DIR/status.md")

  # Check for injected directives
  local directive=""
  if [[ -f "$RALPH_DIR/directives.md" ]]; then
    directive=$(cat "$RALPH_DIR/directives.md")
    mv "$RALPH_DIR/directives.md" "$RALPH_DIR/directive-consumed-$1.md"
  fi

  cat <<PROMPT
## You are executing ONE step of a plan.

Read the plan: $PLAN
Read .ralph/status.md to find where you left off.
Execute the NEXT incomplete step. ONLY that step.

## After completing the step:
1. Run verification (build/test/lint as specified in the plan)
2. Self-review: check for bugs, wrong files modified, code review issues
3. Fix issues found
4. Commit with a descriptive message
5. Update .ralph/status.md with progress
6. Output RALPH_STEP_DONE and STOP

## Signals
- RALPH_STEP_DONE = step done, STOP immediately (do NOT continue to next step)
- RALPH_DONE = ALL steps complete, plan finished
- Do NOT push to main or master
$([ -n "$directive" ] && echo "
## Operator directive (priority)
$directive")

## Previous progress
$progress
PROMPT
}

# --- Interrupt handling ---
INTERRUPTED=0
trap 'INTERRUPTED=1; echo ""; echo ">>> Interrupt received — finishing iteration..."' INT

write_meta "running" 0

# --- Watch mode ---
RICH_PID=""
if [[ $RICH -eq 1 ]]; then
  if command -v ralph-watch &>/dev/null; then
    exec 3>&1                              # save terminal fd
    ralph-watch -f "$(pwd)" >&3 2>&3 &     # render from log file → terminal
    RICH_PID=$!
    exec 1>/dev/null                       # silence simple-ralph's stdout
  else
    echo "Warning: ralph-watch not found, falling back to plain output"
    RICH=0
  fi
fi
trap '[[ -n "${RICH_PID:-}" ]] && kill "$RICH_PID" 2>/dev/null; wait "$RICH_PID" 2>/dev/null' EXIT

# --- Header (plain mode only; ralph-watch shows its own) ---
if [[ $RICH -eq 0 ]]; then
  echo "simple-ralph | plan: $(basename "$PLAN") | max: $MAX_ITER | dir: $(pwd)"
  echo ""
  echo "Monitor (in another terminal):"
  echo "  rt $(pwd)"
  echo "  ralph-watch $(pwd)"
  echo ""
fi

# --- Main loop ---
for ((i=1; i<=MAX_ITER; i++)); do
  [[ $INTERRUPTED -eq 1 ]] && break

  ITER_LOG="$RALPH_DIR/iteration-$i.log"
  write_meta "running" "$i"

  HEADER="=== iteration $i/$MAX_ITER  $(date '+%H:%M:%S') ==="
  echo "$HEADER" | tee -a "$OUTPUT_LOG"

  PROMPT=$(build_prompt "$i")

  # Run claude with streaming JSON, extract text + tool calls in real time
  set +eo pipefail  # pipe may have non-zero exits from jq on non-JSON lines
  claude -p --verbose --dangerously-skip-permissions \
    --output-format stream-json \
    --max-turns 30 \
    --allowedTools "$TOOLS" \
    <<< "$PROMPT" 2>>"$ITER_LOG.err" \
    | tee "$ITER_LOG" \
    | jq --unbuffered -r '
        # --verbose stream-json nests content inside .message.content[]
        select(.type == "assistant") |
        .message.content[]? //empty |
        if .type == "text" then
          .text // empty
        elif .type == "tool_use" then
          "[" + (.name // "?") + "] " + (
            if .input.command then .input.command[:80]
            elif .input.file_path then .input.file_path
            elif .input.pattern then .input.pattern
            else (.input | tostring)[:60]
            end
          )
        else empty end
      ' 2>/dev/null \
    | tee -a "$OUTPUT_LOG"
  EXIT=${PIPESTATUS[0]}  # capture claude's exit code (first in pipe)
  set -eo pipefail

  FOOTER="=== iteration $i complete ==="
  echo "$FOOTER" | tee -a "$OUTPUT_LOG"
  echo "" | tee -a "$OUTPUT_LOG"

  # Check step completion FIRST — Claude's narration often mentions "RALPH_DONE"
  # (e.g., "when all steps complete, output RALPH_DONE") which false-triggers the
  # RALPH_DONE grep. Checking RALPH_STEP_DONE first and continuing skips that.
  if grep -q "RALPH_STEP_DONE" "$ITER_LOG"; then
    echo "Step completed — resetting context for next step." | tee -a "$OUTPUT_LOG"
    continue
  fi

  # All steps complete
  if grep -q "RALPH_DONE" "$ITER_LOG"; then
    write_meta "done" "$i"
    echo "Done after $i iteration(s)." | tee -a "$OUTPUT_LOG"
    trap - INT
    exit 0
  fi

  [[ $EXIT -ne 0 ]] && echo "Warning: claude exited $EXIT on iteration $i" | tee -a "$OUTPUT_LOG"
done

trap - INT

# --- Summary ---
if [[ $INTERRUPTED -eq 1 ]]; then
  write_meta "interrupted" "$i"
  echo "Interrupted at iteration $i." | tee -a "$OUTPUT_LOG"
  exit 130
else
  write_meta "max_iterations" "$MAX_ITER"
  echo "Hit max iterations ($MAX_ITER)." | tee -a "$OUTPUT_LOG"
  exit 1
fi
