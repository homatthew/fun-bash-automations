#!/usr/bin/env bash
# simple-ralph — autonomous Claude execution loop
#
# Rich output by default (requires Python + Rich for ralph-watch).
# Falls back to plain output if ralph-watch is not available.
#
# Usage:
#   simple-ralph plan.md                      # Execute plan in cwd
#   simple-ralph -n 5 plan.md                # Max 5 iterations
#   simple-ralph -w my-feature plan.md       # Run in a fresh worktree
#   simple-ralph --plain plan.md             # Plain output (no Rich)
#
# Monitor (from another terminal):
#   rt                        # Shell function (tail -f .ralph/output.log)
#   ralph-watch               # Rich console version

set -euo pipefail

# --- Defaults ---
MAX_ITER=20
MAX_FAILURES=3
MAX_TURNS=50
PLAN=""
WORK_DIR=""
WORKTREE_NAME=""
RICH=1
STATUS_MODE=0
TOOLS="Edit Read Write Glob Grep Bash"
WORKTREE_BASE="${HOME}/worktrees"

# --- Parse args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--max)       MAX_ITER="$2"; shift 2 ;;
    -r|--max-retries) MAX_FAILURES="$2"; shift 2 ;;
    -T|--max-turns) MAX_TURNS="$2"; shift 2 ;;
    -t|--tools)     TOOLS="$2"; shift 2 ;;
    -d|--dir)       WORK_DIR="$2"; shift 2 ;;
    -w|--worktree)  WORKTREE_NAME="$2"; shift 2 ;;
    --plain)       RICH=0; shift ;;
    --status)
      STATUS_MODE=1
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        WORK_DIR="$2"; shift
      fi
      shift ;;
    -h|--help)
      cat <<'HELP'
Usage: simple-ralph [options] plan.md

Options:
  -n, --max N          Absolute iteration cap (default: 20)
  -T, --max-turns N    Claude max turns per iteration (default: 50)
  -r, --max-retries N  Consecutive failures before stopping (default: 3)
  -t, --tools T        Tool scope (default: Edit Read Write Glob Grep Bash)
  -d, --dir DIR        Run in this directory
  -w, --worktree NAME  Create worktree and run there
                       Creates: ~/worktrees/ralph-NAME (branch: ralph/NAME)
  --plain             Plain output (no Rich; default is rich via ralph-watch)
  --status [DIR]       Show session status and health info

Monitor from another terminal:
  rt                        # Shell function (tail -f)
  ralph-watch               # Rich console version
  tail -f .ralph/output.log # Raw

Examples:
  simple-ralph plan.md                    # Run in cwd
  simple-ralph -w refactor plan.md        # Run in ~/worktrees/ralph-refactor
  simple-ralph -n 20 -d /some/repo plan.md
HELP
      exit 0 ;;
    -*) echo "Unknown flag: $1"; exit 1 ;;
    *)  PLAN="$1"; shift ;;
  esac
done

# --- Status mode (early exit) ---
if [[ $STATUS_MODE -eq 1 ]]; then
  [[ -n "$WORK_DIR" ]] && cd "$WORK_DIR"
  RALPH_ROOT=".ralph"
  echo "=== simple-ralph status ==="
  echo "Directory: $(pwd)"
  echo ""

  # Lock status
  LOCKFILE="$RALPH_ROOT/lock"
  if [[ -f "$LOCKFILE" ]]; then
    LOCK_CONTENT=$(cat "$LOCKFILE")
    LOCK_PID="${LOCK_CONTENT%%:*}"
    LOCK_EPOCH="${LOCK_CONTENT##*:}"
    if kill -0 "$LOCK_PID" 2>/dev/null; then
      LOCK_AGE=$(( $(date +%s) - ${LOCK_EPOCH:-0} ))
      echo "Lock: ACTIVE (PID $LOCK_PID, age $(( LOCK_AGE / 60 ))m)"
    else
      echo "Lock: STALE (PID $LOCK_PID not running)"
    fi
  else
    echo "Lock: none"
  fi
  echo ""

  # Current session from meta.json
  META="$RALPH_ROOT/meta.json"
  if [[ -f "$META" ]]; then
    echo "Current session:"
    jq -r '  "  Session:  \(.session)",
      "  Status:   \(.status)",
      "  Plan:     \(.plan)",
      "  Iter:     \(.iter)/\(.max_iter)",
      "  Started:  \(.started)",
      "  CWD:      \(.cwd)"
    ' "$META" 2>/dev/null || echo "  (meta.json unreadable)"
  else
    echo "No active session (no meta.json)"
  fi
  echo ""

  # Crash report
  if [[ -f "$RALPH_ROOT/meta.json" ]]; then
    CURRENT_DIR=$(jq -r '.session' "$META" 2>/dev/null)
    CRASH="$RALPH_ROOT/sessions/$CURRENT_DIR/crash-report.txt"
    if [[ -f "$CRASH" ]]; then
      echo "Crash report: $CRASH"
    fi
  fi

  # Session count and disk usage
  if [[ -d "$RALPH_ROOT/sessions" ]]; then
    SESS_COUNT=$(find "$RALPH_ROOT/sessions" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    DISK_USAGE=$(du -sh "$RALPH_ROOT/sessions" 2>/dev/null | cut -f1)
    echo "Sessions: $SESS_COUNT ($DISK_USAGE on disk)"
  else
    echo "Sessions: none"
  fi
  exit 0
fi

[[ -z "$PLAN" ]] && { echo "Usage: simple-ralph [-n N] [-w name] plan.md"; exit 1; }

# Resolve plan to absolute path before any cd
PLAN="$(cd "$(dirname "$PLAN")" && pwd)/$(basename "$PLAN")"
[[ ! -f "$PLAN" ]] && { echo "Plan not found: $PLAN"; exit 1; }

# --- Worktree setup ---
if [[ -n "$WORKTREE_NAME" ]]; then
  BRANCH="ralph/$WORKTREE_NAME"
  WT_DIR="$WORKTREE_BASE/ralph-$WORKTREE_NAME"

  if [[ -d "$WT_DIR" ]]; then
    echo "Worktree already exists: $WT_DIR"
    echo "Resuming in existing worktree."
  else
    echo "Creating worktree: $WT_DIR (branch: $BRANCH)"
    git worktree add -b "$BRANCH" "$WT_DIR" HEAD
  fi
  cd "$WT_DIR"
elif [[ -n "$WORK_DIR" ]]; then
  mkdir -p "$WORK_DIR"
  cd "$WORK_DIR"
fi

# Load .ralphrc if present (safe: only RALPH_* vars)
if [[ -f ".ralphrc" ]]; then
  while IFS='=' read -r key val; do
    key="${key## }"; key="${key%% }"
    val="${val## }"; val="${val%% }"; val="${val#\"}"; val="${val%\"}"
    case "$key" in
      RALPH_TOOLS)      TOOLS="$val" ;;
      RALPH_MAX_ITER)   MAX_ITER="$val" ;;
      RALPH_MAX_TURNS)  MAX_TURNS="$val" ;;
      \#*|"")           ;; # skip comments and blanks
      *)              echo "Warning: ignoring unknown .ralphrc key: $key" ;;
    esac
  done < .ralphrc
fi

# --- Session naming ---
_ADJECTIVES=(bold calm cool dark fast keen mild neat pale soft warm wild)
_NOUNS=(bear crow deer dove fawn fox hawk hare lark lynx moth pike seal swan wolf wren)
_VERBS=(dash drift glow hum leap roam sail soar spin surf wade weave)
session_name() {
  local a=${_ADJECTIVES[$((RANDOM % ${#_ADJECTIVES[@]}))]}
  local n=${_NOUNS[$((RANDOM % ${#_NOUNS[@]}))]}
  local v=${_VERBS[$((RANDOM % ${#_VERBS[@]}))]}
  echo "$a-$n-$v"
}

# --- Setup ---
RALPH_ROOT=".ralph"
SESSION_NAME=$(session_name)
RALPH_DIR="$RALPH_ROOT/sessions/$SESSION_NAME"
mkdir -p "$RALPH_DIR"

# Hide .ralph from git
EXCLUDE=".git/info/exclude"
[[ -f "$EXCLUDE" ]] && ! grep -qx ".ralph" "$EXCLUDE" 2>/dev/null && echo ".ralph" >> "$EXCLUDE"

# Lockfile — prevent concurrent sessions in the same directory
# Format: PID:EPOCH (prevents PID recycling false positives)
LOCKFILE="$RALPH_ROOT/lock"
if [[ -f "$LOCKFILE" ]]; then
  LOCK_CONTENT=$(cat "$LOCKFILE")
  LOCK_PID="${LOCK_CONTENT%%:*}"
  LOCK_EPOCH="${LOCK_CONTENT##*:}"
  NOW_EPOCH=$(date +%s)
  LOCK_AGE=$(( NOW_EPOCH - ${LOCK_EPOCH:-0} ))
  if kill -0 "$LOCK_PID" 2>/dev/null && (( LOCK_AGE < 86400 )); then
    echo "Another simple-ralph session (PID $LOCK_PID) is running in this directory."
    echo "Use a worktree for parallel runs: simple-ralph -w <name> plan.md"
    exit 1
  fi
  # Stale lock (PID dead or >24h old) — remove it
  rm -f "$LOCKFILE"
fi
echo "$$:$(date +%s)" > "$LOCKFILE"
RICH_PID=""
trap 'rm -f "$LOCKFILE"; [[ -n "$RICH_PID" ]] && kill "$RICH_PID" 2>/dev/null && wait "$RICH_PID" 2>/dev/null' EXIT

# Symlinks for monitoring tools (rt, ralph-watch read .ralph/output.log)
rm -f "$RALPH_ROOT/current" "$RALPH_ROOT/output.log" "$RALPH_ROOT/meta.json"
ln -s "sessions/$SESSION_NAME" "$RALPH_ROOT/current"
ln -s "sessions/$SESSION_NAME/output.log" "$RALPH_ROOT/output.log"
ln -s "sessions/$SESSION_NAME/meta.json" "$RALPH_ROOT/meta.json"

# Combined output log — this is what you tail
OUTPUT_LOG="$RALPH_DIR/output.log"
: > "$OUTPUT_LOG"

# TTL: prune sessions older than 24h (log what gets removed)
STALE_SESSIONS=$(find "$RALPH_ROOT/sessions" -maxdepth 1 -mindepth 1 -type d -mmin +1440 2>/dev/null || true)
if [[ -n "$STALE_SESSIONS" ]]; then
  STALE_COUNT=$(echo "$STALE_SESSIONS" | wc -l | tr -d ' ')
  echo "$STALE_SESSIONS" | xargs rm -rf 2>/dev/null || true
  echo "Pruned $STALE_COUNT stale session(s) older than 24h" >> "$OUTPUT_LOG"
fi

# --- Meta tracking ---
write_meta() {
  cat > "$RALPH_DIR/meta.json" <<-JSON
	{
	  "plan": "$PLAN",
	  "pid": $$,
	  "session": "$SESSION_NAME",
	  "status": "$1",
	  "iter": $2,
	  "max_iter": $MAX_ITER,
	  "started": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
	  "cwd": "$(pwd)"
	}
	JSON
}

# --- Crash report ---
write_crash_report() {
  local fail_iter="$1" result_subtype="$2" exit_code="$3"
  local report="$RALPH_DIR/crash-report.txt"
  {
    echo "=== simple-ralph crash report ==="
    echo "Time:      $(date)"
    echo "Session:   $SESSION_NAME"
    echo "Plan:      $PLAN"
    echo "Directory: $(pwd)"
    echo ""
    echo "=== Failure details ==="
    echo "Failed at iteration: $fail_iter"
    echo "Result subtype:      $result_subtype"
    echo "Exit code:           $exit_code"
    echo "Consecutive failures: $failures/$MAX_FAILURES"
    echo ""
    echo "=== Last 20 lines of output ==="
    tail -20 "$OUTPUT_LOG" 2>/dev/null || echo "(output log not available)"
    echo ""
    echo "=== Full iteration log ==="
    echo "$RALPH_DIR/iteration-$fail_iter.log"
    echo ""
    echo "=== Re-run command ==="
    echo "simple-ralph -T $MAX_TURNS -n $MAX_ITER -r $MAX_FAILURES \"$PLAN\""
  } > "$report"
  echo "Crash report: $report" | tee -a "$OUTPUT_LOG"
}

# --- Exit banner ---
fmt_duration() {
  local secs=$1
  if (( secs >= 3600 )); then
    printf "%dh%dm" $((secs/3600)) $(( (secs%3600)/60 ))
  elif (( secs >= 60 )); then
    printf "%dm%ds" $((secs/60)) $((secs%60))
  else
    printf "%ds" "$secs"
  fi
}

print_exit_banner() {
  local status="$1" detail="$2"
  local elapsed=$(( $(date +%s) - SESSION_START_EPOCH ))
  local dur
  dur=$(fmt_duration "$elapsed")
  {
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  $status"
    echo ""
    echo "  Session:    $SESSION_NAME"
    echo "  Plan:       $(basename "$PLAN")"
    echo "  Iterations: $iter/$MAX_ITER"
    echo "  Duration:   $dur"
    [[ -n "$detail" ]] && echo "  $detail"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  } | tee -a "$OUTPUT_LOG"
}

# --- Prompt builder ---
build_prompt() {
  local progress="Fresh start — no prior iterations."
  [[ -f "$RALPH_DIR/status.md" ]] && progress=$(cat "$RALPH_DIR/status.md")

  # Check for injected directives
  local directive=""
  if [[ -f "$RALPH_DIR/directives.md" ]]; then
    directive=$(cat "$RALPH_DIR/directives.md")
    mv "$RALPH_DIR/directives.md" "$RALPH_DIR/directive-consumed-$1.md"
  fi

  cat <<PROMPT
## You are executing ONE step of a plan.

1. Read the plan: $PLAN — this is the AUTHORITATIVE list of all steps.
2. Read $RALPH_DIR/status.md to see which steps are already done.
3. Cross-reference: find the first step in the PLAN that is NOT marked done in status.md.
4. Execute that step. ONLY that step.

IMPORTANT: status.md only tracks what's been completed. The PLAN defines all steps.
If status.md shows 3 steps done but the plan has 7 steps, you have 4 steps remaining.

## After completing the step:
1. Run verification (build/test/lint as specified in the plan)
2. Self-review: check for bugs, wrong files modified, code review issues
3. Fix issues found
4. Run a final lint/format pass (ruff check, ruff format --check, or the project's linter). Fix issues before declaring done.
5. If the project has a code-review or simplify skill, use it on changed files before declaring done.
6. Commit with a descriptive message
7. Update $RALPH_DIR/status.md with progress
8. Output RALPH_STEP_DONE and STOP

## Stacked PRs (if applicable)
- Use git rebase <parent-branch> to keep branches in sync
- Use gh pr create --base <parent-branch> not --base main

## Signals
- RALPH_STEP_DONE = step done, STOP immediately (do NOT continue to next step)
- RALPH_DONE = ALL steps complete, plan finished
- Do NOT push to main or master
$([ -n "$directive" ] && echo "
## Operator directive (priority)
$directive")

## Previous progress
$progress
PROMPT
}

# --- Interrupt handling ---
INTERRUPTED=0
trap 'INTERRUPTED=1; echo ""; echo ">>> Interrupt received — finishing iteration..."' INT

write_meta "running" 0

# --- Watch mode ---
RICH_PID=""
if [[ $RICH -eq 1 ]]; then
  if command -v ralph-watch &>/dev/null; then
    exec 3>&1                              # save terminal fd
    ralph-watch -f "$(pwd)" >&3 2>&3 &     # render from log file → terminal
    RICH_PID=$!
    exec 1>/dev/null                       # silence simple-ralph's stdout
  else
    echo "Warning: ralph-watch not found. Install: uv tool install -e ~/repos/fun-bash-automations/ralph"
    RICH=0
  fi
fi
# Note: EXIT trap (lockfile + RICH_PID cleanup) is set in the setup section above

# --- Header (plain mode only; ralph-watch shows its own) ---
if [[ $RICH -eq 0 ]]; then
  echo "simple-ralph | $SESSION_NAME | plan: $(basename "$PLAN") | max: $MAX_ITER | dir: $(pwd)"
  echo ""
  echo "Monitor (in another terminal):"
  echo "  rt $(pwd)"
  echo "  ralph-watch $(pwd)"
  echo ""
fi

# --- Main loop ---
SESSION_START_EPOCH=$(date +%s)
iter=0
failures=0

while ((iter < MAX_ITER)); do
  [[ $INTERRUPTED -eq 1 ]] && break
  ((iter++))

  ITER_LOG="$RALPH_DIR/iteration-$iter.log"
  write_meta "running" "$iter"

  ITER_START=$(date '+%H:%M:%S')
  echo "=== iteration $iter  $ITER_START  started ===" | tee -a "$OUTPUT_LOG"

  PROMPT=$(build_prompt "$iter")

  # Run claude with streaming JSON, extract text + tool calls in real time
  set +eo pipefail  # pipe may have non-zero exits from jq on non-JSON lines
  claude -p --verbose --dangerously-skip-permissions \
    --output-format stream-json \
    --max-turns "$MAX_TURNS" \
    --allowedTools "$TOOLS" \
    <<< "$PROMPT" 2>>"$ITER_LOG.err" \
    | tee "$ITER_LOG" \
    | jq --unbuffered -r '
        # --verbose stream-json nests content inside .message.content[]
        select(.type == "assistant") |
        .message.content[]? //empty |
        if .type == "text" then
          .text // empty
        elif .type == "tool_use" then
          "[" + (.name // "?") + "] " + (
            if .input.command then .input.command[:80]
            elif .input.file_path then .input.file_path
            elif .input.pattern then .input.pattern
            else (.input | tostring)[:60]
            end
          )
        else empty end
      ' 2>/dev/null \
    | tee -a "$OUTPUT_LOG"
  EXIT=${PIPESTATUS[0]}  # capture claude's exit code (first in pipe)
  set -eo pipefail

  # Parse result event for diagnostics
  RESULT_SUBTYPE=$(jq -r 'select(.type == "result") | .subtype // empty' "$ITER_LOG" 2>/dev/null | head -1)
  [[ -z "$RESULT_SUBTYPE" ]] && RESULT_SUBTYPE="unknown"

  # Signal detection — must match signals as standalone output, not narration.
  # Claude often echoes "output RALPH_DONE when finished" which false-triggers grep.
  # Use the PARSED output log (text only) and require the signal on its own line
  # or as the dominant content of a line (not embedded in a sentence about signals).
  PARSED_OUTPUT=$(jq -r '
    select(.type == "assistant") |
    .message.content[]? // empty |
    select(.type == "text") | .text // empty
  ' "$ITER_LOG" 2>/dev/null || true)

  if echo "$PARSED_OUTPUT" | grep -qE '^[[:space:]]*RALPH_STEP_DONE[[:space:]]*$'; then
    failures=0  # progress — reset failure counter
    echo "=== iteration $iter  $(date '+%H:%M:%S')  result: success  exit: $EXIT  failures: 0/$MAX_FAILURES ===" | tee -a "$OUTPUT_LOG"
    echo "" | tee -a "$OUTPUT_LOG"
    continue
  fi

  if echo "$PARSED_OUTPUT" | grep -qE '^[[:space:]]*RALPH_DONE[[:space:]]*$'; then
    echo "=== iteration $iter  $(date '+%H:%M:%S')  result: plan_complete  exit: $EXIT ===" | tee -a "$OUTPUT_LOG"
    echo "" | tee -a "$OUTPUT_LOG"
    write_meta "done" "$iter"
    print_exit_banner "Plan complete" ""
    trap - INT
    exit 0
  fi

  # No signal — count as failure
  ((failures++))

  # Log specific failure reason
  if [[ "$RESULT_SUBTYPE" == "error_max_turns" ]]; then
    echo "Claude hit turn limit ($MAX_TURNS) — step was too complex for one iteration" | tee -a "$OUTPUT_LOG"
  elif [[ $EXIT -ne 0 ]]; then
    echo "Warning: claude exited $EXIT on iteration $iter (result: $RESULT_SUBTYPE)" | tee -a "$OUTPUT_LOG"
  fi

  echo "=== iteration $iter  $(date '+%H:%M:%S')  result: $RESULT_SUBTYPE  exit: $EXIT  failures: $failures/$MAX_FAILURES ===" | tee -a "$OUTPUT_LOG"
  echo "" | tee -a "$OUTPUT_LOG"

  if ((failures >= MAX_FAILURES)); then
    write_meta "failed" "$iter"
    write_crash_report "$iter" "$RESULT_SUBTYPE" "$EXIT"
    print_exit_banner "Stopped — $failures consecutive failures" "Last result: $RESULT_SUBTYPE"
    trap - INT
    exit 1
  fi
  echo "No completion signal ($failures/$MAX_FAILURES consecutive failures)." | tee -a "$OUTPUT_LOG"
done

trap - INT

# --- Summary ---
if [[ $INTERRUPTED -eq 1 ]]; then
  write_meta "interrupted" "$iter"
  write_crash_report "$iter" "interrupted" "130"
  print_exit_banner "Interrupted" ""
  exit 130
else
  write_meta "max_iterations" "$MAX_ITER"
  write_crash_report "$iter" "max_iterations" "1"
  print_exit_banner "Stopped — hit iteration cap" ""
  exit 1
fi
