#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    TARGET="$(readlink "$SOURCE")"
    case "$TARGET" in
        /*) SOURCE="$TARGET" ;;
        *) SOURCE="$DIR/$TARGET" ;;
    esac
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
STACK_SKILL="$ROOT/llm/skills/stack/SKILL.md"
PUSH_GATE_SKILL="$ROOT/llm/skills/push-gate/SKILL.md"
STACK_BIN="$ROOT/bin/stack"
PG_HELPER="$ROOT/llm/hooks/push-gate.sh"

usage() {
    cat <<'EOF'
Usage: agent-stack-refresh [--full] [--stack-help] [--pg-help]

Print the current stack / push-gate workflow reset for agents with stale
context. Default output is short and safe to paste into an agent thread.

Options:
  --full        Include the full stack and push-gate SKILL.md bodies.
  --stack-help  Append `stack --help`.
  --pg-help     Append `pg --help` from the push-gate helper.
EOF
}

full="false"
stack_help="false"
pg_help="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --full)
            full="true"
            ;;
        --stack-help)
            stack_help="true"
            ;;
        --pg-help)
            pg_help="true"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

cat <<EOF
STALE AGENT RESET: stack / push-gate workflow changed.

Canonical live files to re-read now:
  - $STACK_SKILL
  - $PUSH_GATE_SKILL
  - $ROOT/llm/stack/README.md
  - $ROOT/llm/command-guard-policy.md

Current rules:
  - Agents should run agent-stack-refresh directly; stack-latest is a human
    zsh alias and may not exist in non-interactive agent shells.
  - Use the stack skill before stack commands.
  - Use the push-gate skill before pg / push-gate commands.
  - Dolt is required for stack trunk commands:
      install: brew install dolt
      verify: dolt version
      store: ~/.push-gate/dolt-store by default; PG_STORE_DIR overrides it.
  - Stack manifests are Dolt-backed through push-gate, not repo .stack JSON.
  - Prefer: stack trunk init/add/status/materialize/push --stack <name>
  - Reorder existing stack items with stack trunk move; prune them with
    stack trunk remove. Do not create a -v2 stack just to reorder items.
  - Compatibility only: stack trunk ... --manifest <path>
  - Stack-managed restacks enable repo-local rerere automatically:
      git config --local rerere.enabled true
      git config --local rerere.autoupdate true
    Scratch clones receive the source repo's rerere cache before preflight.
    Separate clones need their own local rerere config and cache/history.
  - Trunk approval flow:
      1. Agent: pg prepare-trunk --stack <name> --what ... --why ... --approach ... --item-briefs <file>
      2. Human: pg trunk --stack <name>
      3. Agent: stack trunk push --stack <name>
  - For composed-stack CI without pushing item branches:
      stack trunk push --stack <name> --tip
  - pg trunk drafts use stack_items with pointer_commit, base_commit,
    contained_commits, and changed_files grouped by readable labels.
  - Each stack item must have brief.what / brief.why / brief.approach.
  - Use YAML bullet lists in item briefs; keep top-level prepare-trunk focused
    on cross-item what / why / approach.
  - Never bypass push-gate; if approval is needed, prepare first and ask the
    human to run pg / pg trunk in an interactive terminal.

Useful commands:
  stack --help
  pg --help
  agent-stack-refresh --full
  agent-stack-refresh --stack-help --pg-help
EOF

if [[ "$full" == "true" ]]; then
    printf '\n===== %s =====\n' "$STACK_SKILL"
    sed -n '1,260p' "$STACK_SKILL"
    printf '\n===== %s =====\n' "$PUSH_GATE_SKILL"
    sed -n '1,260p' "$PUSH_GATE_SKILL"
fi

if [[ "$stack_help" == "true" ]]; then
    printf '\n===== stack --help =====\n'
    "$STACK_BIN" --help
fi

if [[ "$pg_help" == "true" ]]; then
    printf '\n===== pg --help =====\n'
    bash "$PG_HELPER" --help
fi
